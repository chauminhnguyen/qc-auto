OPENROUTER_API_KEY=
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_REASONING_EFFORT=none
# Shared provider for testcase generation and BRD semantic linking: openrouter or anthropic.
LLM_PROVIDER=openrouter
# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional testcase-only override; otherwise OPENROUTER_MAX_TOKENS applies.
# TESTCASE_MAX_TOKENS=3000
# Maximum BRD testcases emitted per linked requirement (default 3).
# Lower values reduce output; 1 gives positive only, 2 gives positive and negative,
# and 3 allows a boundary case when the requirement states a boundary.
# BRD_MAX_TESTCASES_PER_REQUIREMENT=3
# Minimum valid BRD testcases requested per linked requirement (default 2).
# Must be less than or equal to BRD_MAX_TESTCASES_PER_REQUIREMENT.
# BRD_MIN_TESTCASES_PER_REQUIREMENT=2
