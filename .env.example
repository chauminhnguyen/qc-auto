OPENROUTER_API_KEY=
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_REASONING_EFFORT=none
# Shared provider for testcase generation and BRD semantic linking: openrouter or anthropic.
LLM_PROVIDER=openrouter
# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Chat CLI provider: local, openrouter, or anthropic.
# Set CHAT_PROVIDER=anthropic to use the Anthropic Messages API directly.
CHAT_PROVIDER=local
# Optional chat-only overrides. By default the chat CLI uses ANTHROPIC_MODEL
# when CHAT_PROVIDER=anthropic, or OPENROUTER_MODEL when CHAT_PROVIDER=openrouter.
# CHAT_MODEL=
# CHAT_API_BASE=
# CHAT_API_KEY=
# CHAT_MAX_TOKENS=5120
# Optional testcase-only override; otherwise OPENROUTER_MAX_TOKENS applies.
# TESTCASE_MAX_TOKENS=3000
# Maximum BRD testcases emitted per linked requirement (default 3).
# Lower values reduce output; 1 gives positive only, 2 gives positive and negative,
# and 3 allows a boundary case when the requirement states a boundary.
# BRD_MAX_TESTCASES_PER_REQUIREMENT=3
# Minimum valid BRD testcases requested per linked requirement (default 2).
# Must be less than or equal to BRD_MAX_TESTCASES_PER_REQUIREMENT.
# BRD_MIN_TESTCASES_PER_REQUIREMENT=2

# Write-safe Playwright exploration. Keep account verification values private.
# Auth endpoints pass only when configured; plain paths permit POST, or use METHOD:/path.
WRITE_SAFE_AUTH_PATHS=
WRITE_SAFE_DECISIONS=decisions.json
WRITE_SAFE_REPORT_DIR=safety_reports
WRITE_SAFE_DISCOVERY_DIR=safety_reports/discovery
WRITE_SAFE_DISCOVERY=1
# Configure a reliable identity signal only if the target exposes one.
WRITE_SAFE_ACCOUNT_HEADER=
WRITE_SAFE_ACCOUNT_VALUE=
# Alternative identity signal; configure both values together.
WRITE_SAFE_ACCOUNT_COOKIE=
WRITE_SAFE_ACCOUNT_COOKIE_VALUE=
# Optional API-supported string field used to mark approved real creates.
WRITE_SAFE_QA_FIELD=
